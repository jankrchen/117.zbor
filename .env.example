# IBKR Flex Web Service (read-only). Copy to .env and fill in. Never commit .env.
# Token: Portal -> Performance & Reports -> Flex Queries -> Flex Web Service Configuration
IBKR_FLEX_TOKEN=
# One or more Flex Query IDs, comma separated (e.g. Trade Confirmation + Activity query)
IBKR_FLEX_QUERY_IDS=
# Set to 1 to also import forex (CASH) trades such as automatic currency conversions
IBKR_INCLUDE_FX=0
